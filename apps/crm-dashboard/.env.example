# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/lulu_discord

DISCORD_TOKEN=

# (Optional) Static Fallback Server ID for single-guild development environments
GUILD_ID=

# ── Discord OAuth2 & Auth.js ──
# Run `npx auth secret` or generate any random 32-character secret string
AUTH_SECRET=

# Discord Developer Portal -> Your App -> OAuth2:
# Client ID
AUTH_DISCORD_ID=
# Client Secret
AUTH_DISCORD_SECRET=

# ── Whitelist Access Control ──
# Comma-separated list of Discord user Snowflake IDs allowed to access the dashboard.
# Example: ALLOWED_DISCORD_IDS="123456789012345678,987654321098765432"
# If left empty, initial setup mode is enabled with an on-screen warning showing your Discord ID.
ALLOWED_DISCORD_IDS=

