// ──────────────────────────────────────────────
// Lulu Discord Suite — Shared Database Schema
// ──────────────────────────────────────────────
// This schema powers both Discord bots and the
// CRM dashboard. Keep it in sync across all apps.
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// USER
// ──────────────────────────────────────────────
// Represents a Discord user tracked by the bots.
// The id matches the Discord snowflake.
model User {
  id            String   @id @default("") // Discord snowflake, set on first interaction
  username      String   @default("")
  globalName    String?  @default("")
  avatarUrl     String?  @default("")

  // ── Economy ──
  gominolas     Int      @default(0)      // Main currency ("gummies")
  totalEarned   Int      @default(0)      // Lifetime gominolas earned
  totalSpent    Int      @default(0)      // Lifetime gominolas spent

  // ── Polymorphia ──
  polymorphiaState PolymorphiaState?

  // ── Inventory ──
  items         UserItem[]

  // ── Transaction history ──
  transactions  Transaction[]

  // ── Timestamps ──
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ──────────────────────────────────────────────
// ITEM
// ──────────────────────────────────────────────
// Catalog of collectible / purchasable items.
// Used by minigames and the shop system.
model Item {
  id          String     @id @default(cuid())
  name        String     @unique
  description String     @default("")
  emoji       String     @default("🎁")     // Discord emoji for display
  price       Int        @default(0)        // Cost in gominolas (0 = not for sale)
  category    String     @default("general") // e.g. "butterfly", "consumable", "cosmetic"
  rarity      String     @default("common")  // common / uncommon / rare / epic / legendary
  isCollectible Boolean  @default(false)    // Can be found via minigames?
  isActive    Boolean    @default(true)     // Soft-delete / disable flag

  owners      UserItem[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ──────────────────────────────────────────────
// USER ITEM (Inventory junction)
// ──────────────────────────────────────────────
// Tracks how many of a given item a user owns.
model UserItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

// ──────────────────────────────────────────────
// POLYMORPHIA STATE
// ──────────────────────────────────────────────
// Tracks the active polymorphia game state per user.
model PolymorphiaState {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive      Boolean  @default(false)    // Is the user currently polymorphed?
  currentForm   String   @default("")       // e.g. "yuumi", "teemo", "poro"
  formDuration  Int      @default(0)        // Duration in minutes
  startedAt     DateTime?                    // When the current form started
  endsAt        DateTime?                    // When the current form expires

  // ── Butterfly hunt stats ──
  butterfliesCaught Int  @default(0)
  totalButterflies   Int  @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ──────────────────────────────────────────────
// TRANSACTION
// ──────────────────────────────────────────────
// Immutable audit log of every gominola movement.
model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String   // "earn" | "spend" | "refund" | "admin"
  amount      Int      // Positive amount (sign is derived from type)
  balanceAfter Int     // User's gominolas balance after this transaction
  description String   @default("")         // e.g. "Caught a butterfly!", "Bought Yuumi form"

  referenceId String?  // Optional: links to a related entity (itemId, gameId, etc.)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}